{
  "$schema": "https://farmslot.io/schemas/recipe-v1.schema.json",
  "title": "Cross margin orders can be placed when perpsCrossMarginEnabled is on",
  "description": "With perpsCrossMarginEnabled on, pick Cross in the Pro form and place a $15 SOL order on the Hyperliquid testnet Trading account that opens a Cross-tagged position (closed in teardown). Lite trading an open Cross position and Flip being hidden for Cross are proven by focused tests.",
  "workflow": {
    "entry": "setup-cross-flag",
    "nodes": {
      "done": {
        "action": "end",
        "status": "pass"
      },
      "setup-cross-flag": {
        "action": "metamask.feature_flags.set",
        "flags": {
          "perpsCrossMarginEnabled": {
            "enabled": true,
            "minimumVersion": "0.0.0"
          }
        },
        "intent": "Turn cross margin on the way the remote flag rollout does",
        "next": "setup-cross-pro"
      },
      "setup-cross-pro": {
        "action": "call",
        "ref": "perps.pro-order-start-state",
        "params": {
          "account": "Trading",
          "provider": "hyperliquid",
          "network": "testnet",
          "market": "SOL",
          "trading_state": "preserve"
        },
        "intent": "Reach the Pro SOL market where a new position's margin mode is still free",
        "next": "setup-cross-sol-flat"
      },
      "setup-cross-sol-flat": {
        "action": "metamask.perps.ensure_positions",
        "market": "SOL",
        "state": "none",
        "intent": "Start AC5 with no SOL position so Cross can be picked",
        "next": "ac5-scroll-mode"
      },
      "ac5-scroll-mode": {
        "action": "ui.scroll",
        "test_id": "perps-pro-order-form-margin-mode",
        "scroll_into_view": true,
        "intent": "Bring the margin mode control on screen",
        "next": "ac5-open-mode"
      },
      "ac5-open-mode": {
        "action": "ui.press",
        "test_id": "perps-pro-order-form-margin-mode",
        "intent": "Open the margin mode choice the PM could not use",
        "next": "ac5-wait-cross-option"
      },
      "ac5-wait-cross-option": {
        "action": "ui.wait_for",
        "test_id": "perps-margin-mode-cross",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "Show the Cross choice offered without the coming-soon note",
        "next": "ac5-screenshot-sheet"
      },
      "ac5-screenshot-sheet": {
        "action": "ui.screenshot",
        "path": "screenshots/evidence-ac5-margin-mode-sheet.png",
        "label": "AC5: Cross offered in the margin mode sheet",
        "intent": "Show reviewers Cross is selectable once the flag is on",
        "next": "ac5-pick-cross"
      },
      "ac5-pick-cross": {
        "action": "ui.press",
        "test_id": "perps-margin-mode-cross",
        "intent": "Choose Cross margin for the new order",
        "next": "ac5-assert-cross-label"
      },
      "ac5-assert-cross-label": {
        "action": "ui.wait_for",
        "text": "Cross",
        "text_match": "contains",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "Confirm the order form now reads Cross",
        "next": "ac5-scroll-size"
      },
      "ac5-scroll-size": {
        "action": "ui.scroll",
        "test_id": "perps-pro-order-form-size-card",
        "scroll_into_view": true,
        "intent": "Expose the order size input",
        "next": "ac5-set-size"
      },
      "ac5-set-size": {
        "action": "ui.set_input",
        "test_id": "perps-pro-order-form-size-input",
        "value": "15",
        "intent": "Enter a $15 order through the size field",
        "next": "ac5-scroll-submit"
      },
      "ac5-scroll-submit": {
        "action": "ui.scroll",
        "test_id": "perps-pro-order-form-summary-fees",
        "scroll_into_view": true,
        "intent": "Expose the place order button",
        "next": "ac5-wait-submit"
      },
      "ac5-wait-submit": {
        "action": "ui.wait_for",
        "test_id": "perps-pro-order-form-place-order",
        "expected": "visible",
        "timeout_ms": 10000,
        "intent": "Make sure the order can be submitted",
        "next": "ac5-place-order"
      },
      "ac5-place-order": {
        "action": "ui.press",
        "test_id": "perps-pro-order-form-place-order",
        "intent": "Place the Cross order",
        "next": "ac5-assert-position-open"
      },
      "ac5-assert-position-open": {
        "action": "metamask.perps.assert_positions",
        "market": "SOL",
        "state": "open",
        "timeout_ms": 30000,
        "intent": "Require the Cross order to open a SOL position",
        "next": "ac5-swipe-to-positions"
      },
      "ac5-assert-cross-tag": {
        "action": "ui.wait_for",
        "test_id": "cross-margin-tag-pro-SOL",
        "expected": "visible",
        "timeout_ms": 20000,
        "intent": "Confirm the new position is tagged Cross",
        "next": "ac5-screenshot-position"
      },
      "ac5-screenshot-position": {
        "action": "ui.screenshot",
        "path": "screenshots/evidence-ac5-cross-position.png",
        "label": "AC5: new SOL position tagged Cross, Reverse disabled",
        "intent": "Show reviewers the order opened a Cross position",
        "next": "teardown-cross-sol"
      },
      "teardown-cross-sol": {
        "action": "metamask.perps.ensure_positions",
        "market": "SOL",
        "state": "none",
        "intent": "Close the SOL position this run opened",
        "next": "teardown-cross-flag"
      },
      "teardown-cross-flag": {
        "action": "metamask.feature_flags.clear",
        "intent": "Return the flag to its default so later runs start clean",
        "next": "ac3-run-unit-tests"
      },
      "ac6-run-view-test": {
        "action": "command",
        "cmd": "yarn test:view:one app/components/UI/Perps/Views/PerpsOrderView/PerpsOrderView.view.test.tsx -t \"Cross\" > /tmp/cross-margin-view.log 2>&1\nstatus=$?\ntail -30 /tmp/cross-margin-view.log\nexit $status",
        "timeout_ms": 300000,
        "allow_failure": true,
        "intent": "Prove Lite trades an open Cross position in Cross when the flag is on, and still warns when it is off",
        "next": "ac6-assert-view-test-pass"
      },
      "ac6-assert-view-test-pass": {
        "action": "assert_exit_code",
        "source": "ac6-run-view-test",
        "expected": 0,
        "intent": "Require the Lite cross-margin view tests to pass",
        "next": "done"
      },
      "ac5-swipe-to-positions": {
        "action": "ui.swipe",
        "target": {
          "x": 200,
          "y": 700
        },
        "direction": "up",
        "distance": 500,
        "duration_ms": 400,
        "intent": "Move the positions list toward the viewport",
        "next": "ac5-swipe-to-sol-card"
      },
      "ac5-swipe-to-sol-card": {
        "action": "ui.swipe",
        "target": {
          "x": 200,
          "y": 700
        },
        "direction": "up",
        "distance": 500,
        "duration_ms": 400,
        "intent": "Bring the new SOL position card on screen",
        "next": "ac5-assert-cross-tag"
      },
      "ac3-run-unit-tests": {
        "action": "command",
        "cmd": "yarn jest app/components/UI/Perps/utils/orderParams.test.ts app/components/UI/Perps/components/PerpsMarginModeBottomSheet/PerpsMarginModeBottomSheet.test.tsx app/components/UI/Perps/Views/PerpsProMarketView/components/PerpsProOrderFormPanel.test.tsx app/components/UI/Perps/Views/PerpsProMarketView/components/PerpsProOrderForm/usePerpsProOrderForm.test.ts app/components/UI/Perps/Views/PerpsProMarketView/components/PerpsProPositionCard.test.tsx app/components/UI/Perps/components/PerpsModifyActionSheet/PerpsModifyActionSheet.test.tsx --no-coverage > /tmp/cross-margin-jest.log 2>&1\nstatus=$?\ntail -40 /tmp/cross-margin-jest.log\nexit $status",
        "timeout_ms": 300000,
        "allow_failure": true,
        "intent": "Prove the cross-margin order wiring, margin mode sheet and Flip gating through focused tests",
        "next": "ac3-assert-tests-pass"
      },
      "ac3-assert-tests-pass": {
        "action": "assert_exit_code",
        "source": "ac3-run-unit-tests",
        "expected": 0,
        "intent": "Require the cross-margin tests to pass",
        "next": "ac6-run-view-test"
      }
    }
  }
}
