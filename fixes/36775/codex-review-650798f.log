  );

  const newLiquidationDistance = useMemo(
    () => calculateDistance(newLiquidationPrice),
    [calculateDistance, newLiquidationPrice],
  );

  return {
    position,
    isLoading: isInitialLoading,
    hasValidPositionData,
    currentMargin,
    newMargin,
    positionValue,
    maxAmount,
    exchangeMaxAmount,
    currentLiquidationPrice,
    newLiquidationPrice,
    currentLiquidationDistance,
    newLiquidationDistance,
    spendableBalance,
    currentPrice,
    isAddMode,
    positionLeverage,
  };
}

