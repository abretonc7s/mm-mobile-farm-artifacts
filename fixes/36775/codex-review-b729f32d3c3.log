    89	/**
    90	 * Hook for margin adjustment data and calculations
    91	 *
    92	 * This hook encapsulates all business logic for the adjust margin view:
    93	 * - Fetches live position data from WebSocket subscription
    94	 * - Calculates max removable/addable margin
    95	 * - Computes liquidation price changes
    96	 *
    97	 * @param params - Configuration with coin, mode, and input amount
    98	 * @returns Computed values ready for display
    99	 */
   100	export function usePerpsAdjustMarginData(
   101	  params: UsePerpsAdjustMarginDataParams,
   102	): UsePerpsAdjustMarginDataReturn {
   103	  const { symbol, mode, inputAmount } = params;
   104	  const isAddMode = mode === 'add';
   105	
   106	  // Live data subscriptions
   107	  const { positions, isInitialLoading } = usePerpsLivePositions();
   108	  const { account } = usePerpsLiveAccount();
   109	  const livePrices = usePerpsLivePrices({
   110	    symbols: symbol ? [symbol] : [],
   111	    throttleMs: 1000,
   112	  });
   113	  const { markets } = usePerpsMarkets();
   114	
   115	  // Find live position for this symbol
   116	  const position = useMemo(
   117	    () => positions?.find((p) => p.symbol === symbol) || null,
   118	    [positions, symbol],
   119	  );
   120	
   121	  // Get market info for max leverage fallback
   122	  const marketInfo = useMemo(
   123	    () => (symbol ? markets.find((m) => m.symbol === symbol) : null),
   124	    [symbol, markets],
   125	  );
   126	  const parsedMaxLeverage = parseMaxLeverage(
   127	    marketInfo?.maxLeverage,
   128	    MARGIN_ADJUSTMENT_CONFIG.FallbackMaxLeverage,
   129	  );
   130	  const maxLeverage =
   131	    parsedMaxLeverage > 0
   132	      ? parsedMaxLeverage
   133	      : MARGIN_ADJUSTMENT_CONFIG.FallbackMaxLeverage;
   134	
   135	  // Parse the live position once so every derived calculation uses one snapshot.
   136	  const {
   137	    currentMargin,
   138	    positionValue,
   139	    currentLiquidationPrice,
   140	    positionSize,
   141	    entryPrice,
   142	    isLong,
   143	    parsedPositionLeverage,
   144	    hasValidPositionData,
   145	  } = useMemo(() => {
   146	    const signedPositionSize = parseFiniteNumber(position?.size);
   147	    const currentMarginValue = parseFiniteNumber(position?.marginUsed);
   148	    const positionValueValue = parseFiniteNumber(position?.positionValue);
   149	    const entryPriceValue = parseFiniteNumber(position?.entryPrice);
   150	    const leverageValue = parseFiniteNumber(position?.leverage?.value);
   151	    return {
   152	      currentMargin: currentMarginValue,
   153	      positionValue: positionValueValue,
   154	      currentLiquidationPrice: parseFiniteNumber(position?.liquidationPrice),
   155	      positionSize: Math.abs(signedPositionSize),
   156	      entryPrice: entryPriceValue,
   157	      isLong: signedPositionSize > 0,
   158	      parsedPositionLeverage: leverageValue,
   159	      hasValidPositionData:
   160	        Boolean(position) &&
   161	        currentMarginValue > 0 &&
   162	        positionValueValue > 0 &&
   163	        signedPositionSize !== 0 &&
   164	        entryPriceValue > 0 &&
   165	        leverageValue > 0,
   166	    };
   167	  }, [position]);
   168	
   169	  const currentPrice = useMemo(
   170	    () => parseFiniteNumber(livePrices?.[symbol]?.price),
   171	    [livePrices, symbol],
   172	  );
   173	
   174	  const spendableBalance = useMemo(
   175	    () => parseFiniteNumber(account?.spendableBalance),
   176	    [account],
   177	  );
   178	
   179	  const positionLeverage =
   180	    parsedPositionLeverage > 0 ? parsedPositionLeverage : maxLeverage;
   181	
   182	  // Calculate max removable/addable amount. The exchange max has no price-move
   183	  // headroom so it can validate an amount chosen before a tick.
   184	  const { maxAmount, exchangeMaxAmount } = useMemo(() => {
   185	    if (isAddMode) {
   186	      const addable = Math.max(0, spendableBalance);
   187	      return { maxAmount: addable, exchangeMaxAmount: addable };
   188	    }
   189	    const removable = (priceMoveBufferRatio?: number) =>
   190	      calculateMaxRemovableMargin({
   191	        currentMargin,
   192	        positionSize,
   193	        entryPrice,
   194	        currentPrice,
   195	        positionLeverage,
   196	        notionalValue: positionValue,
   197	        priceMoveBufferRatio,
   198	      });
   199	    return { maxAmount: removable(), exchangeMaxAmount: removable(0) };
   200	  }, [
   201	    isAddMode,
   202	    spendableBalance,
   203	    currentMargin,
   204	    positionSize,
   205	    entryPrice,
   206	    currentPrice,
   207	    positionLeverage,
   208	    positionValue,
   209	  ]);
   210	
   211	  // Calculate new margin after adjustment
   212	  const newMargin = useMemo(() => {
   213	    if (isAddMode) {
   214	      return currentMargin + inputAmount;
   215	    }
   216	    return Math.max(0, currentMargin - inputAmount);
   217	  }, [isAddMode, currentMargin, inputAmount]);
   218	
   219	  // Estimate new liquidation price using anchored + delta approach.
   220	  // Starts from Hyperliquid's actual liquidation price and applies margin delta.
   221	  // To avoid flicker on submit, the view resets inputAmount to 0 immediately,
   222	  // which makes newMargin === currentMargin, returning currentLiquidationPrice.
   223	  const newLiquidationPrice = useMemo(() => {
   224	    if (newMargin === 0 || positionSize === 0) return currentLiquidationPrice;
   225	
   226	    return estimateLiquidationPrice({
   227	      isLong,
   228	      currentMargin,
   229	      newMargin,
   230	      positionSize,
   231	      currentLiquidationPrice,
   232	      maxLeverage,
   233	    });
   234	  }, [
   235	    isLong,
   236	    currentMargin,
   237	    newMargin,
   238	    positionSize,
   239	    currentLiquidationPrice,
   240	    maxLeverage,
   241	  ]);
   242	
   243	  // Calculate liquidation distance
   244	  const calculateDistance = useCallback(
   245	    (liquidationPrice: number) =>
   246	      calculateLiquidationDistance(currentPrice, liquidationPrice),
   247	    [currentPrice],
   248	  );
   249	
   250	  const currentLiquidationDistance = useMemo(
   251	    () => calculateDistance(currentLiquidationPrice),
   252	    [calculateDistance, currentLiquidationPrice],
   253	  );
   254	
   255	  const newLiquidationDistance = useMemo(
   256	    () => calculateDistance(newLiquidationPrice),
   257	    [calculateDistance, newLiquidationPrice],
   258	  );
   259	
   260	  return {
   261	    position,
   262	    isLoading: isInitialLoading,
   263	    hasValidPositionData,
   264	    currentMargin,
   265	    newMargin,
   266	    positionValue,
   267	    maxAmount,
   268	    exchangeMaxAmount,
   269	    currentLiquidationPrice,
   270	    newLiquidationPrice,
   271	    currentLiquidationDistance,
   272	    newLiquidationDistance,
   273	    spendableBalance,
   274	    currentPrice,
   275	    isAddMode,
   276	    positionLeverage,
   277	  };
   278	}

