   105	 * @param params - Current margin, position size, prices, and position leverage
   106	 * @returns Maximum removable margin amount in USD
   107	 */
   108	export function calculateMaxRemovableMargin(
   109	  params: CalculateMaxRemovableMarginParams,
   110	): number {
   111	  const {
   112	    currentMargin,
   113	    positionSize,
   114	    currentPrice,
   115	    positionLeverage,
   116	    notionalValue: providedNotionalValue,
   117	    priceMoveBufferRatio = MARGIN_REMOVAL_PRICE_MOVE_BUFFER,
   118	  } = params;
   119	
   120	  // Validate inputs
   121	  if (
   122	    isNaN(currentMargin) ||
   123	    isNaN(positionLeverage) ||
   124	    currentMargin <= 0 ||
   125	    positionLeverage <= 0
   126	  ) {
   127	    return 0;
   128	  }
   129	
   130	  // Use provided notional value (e.g., from position.positionValue) or calculate from price
   131	  // This allows immediate display before live prices load
   132	  let notionalValue = providedNotionalValue;
   133	  if (
   134	    notionalValue === undefined ||
   135	    isNaN(notionalValue) ||
   136	    notionalValue <= 0
   137	  ) {
   138	    // Fall back to calculating from price if not provided or invalid
   139	    if (
   140	      isNaN(positionSize) ||
   141	      isNaN(currentPrice) ||
   142	      positionSize <= 0 ||
   143	      currentPrice <= 0
   144	    ) {
   145	      return 0;
   146	    }
   147	    notionalValue = positionSize * currentPrice;
   148	  }
   149	
   150	  // Hyperliquid's transfer margin requirement formula:
   151	  // transfer_margin_required = max(initial_margin_required, 0.1 * total_position_value)
   152	  //
   153	  // IMPORTANT: Use the position's actual leverage, not the asset's max leverage
   154	  // A position at 10x leverage needs 10% initial margin ($100 for $1000 notional)
   155	  // NOT the 2% that 50x max leverage would imply
   156	  const initialMarginRequired = notionalValue / positionLeverage;
   157	  const tenPercentMargin =
   158	    notionalValue * MARGIN_ADJUSTMENT_CONFIG.MarginRemovalSafetyBuffer;
   159	
   160	  // Transfer margin required is the MAX of these two constraints
   161	  const transferMarginRequired = Math.max(
   162	    initialMarginRequired,
   163	    tenPercentMargin,
   164	  );
   165	
   166	  // Note: Unrealized PnL is NOT counted as part of "remaining margin" for withdrawals
   167	  // Per Hyperliquid docs, unrealized PnL helps prevent liquidation but doesn't
   168	  // increase your available withdrawal limit for margin transfers
   169	  // Keep headroom for the mark price moving before the exchange processes the
   170	  // request; offering the exact boundary gets rejected on any adverse tick.
   171	  const priceMoveBuffer = notionalValue * priceMoveBufferRatio;
   172	
   173	  // Maximum removable = current margin - required - headroom (non-negative)
   174	  return Math.max(0, currentMargin - transferMarginRequired - priceMoveBuffer);
   175	}

