alconsensys/orgs","repos_url":"https://api.github.com/users/michalconsensys/repos","events_url":"https://api.github.com/users/michalconsensys/events{/privacy}","received_events_url":"https://api.github.com/users/michalconsensys/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Should-fix:** `preserveHomeDroppedFromHistory` is only applied on this `replaceOnSelect` reset.\n\nThe non-replace path still does `StackActions.push(Routes.PERPS.MARKET_DETAILS, detailsParams)` with unstamped params. A later focused market with no Perps history then looks like an Explore entry and the new back check pops out of Perps.\n\nStamp the pushed params the same way as this replace.","created_at":"2026-09-14T14:18:03Z","updated_at":"2026-09-14T14:18:03Z","html_url":"https://github.com/MetaMask/metamask-mobile/pull/35832#discussion_r4006112200","pull_request_url":"https://api.github.com/repos/MetaMask/metamask-mobile/pulls/35832","_links":{"self":{"href":"https://api.github.com/repos/MetaMask/metamask-mobile/pulls/comments/4006112200"},"html":{"href":"https://github.com/MetaMask/metamask-mobile/pull/35832#discussion_r4006112200"},"pull_request":{"href":"https://api.github.com/repos/MetaMask/metamask-mobile/pulls/35832"}},"reactions":{"url":"https://api.github.com/repos/MetaMask/metamask-mobile/pulls/comments/4006112200/reactions","total_count":0,"+1":0,"-1":0,"laugh":0,"hooray":0,"confused":0,"heart":0,"rocket":0,"eyes":0},"start_line":null,"original_start_line":null,"start_side":null,"line":354,"original_line":354,"side":"RIGHT","author_association":"MEMBER","original_position":13,"position":13,"subject_type":"line"}]