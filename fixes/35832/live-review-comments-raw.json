ate();\n+    const hasPerpsStackHistory = (perpsState?.index ?? 0) > 0;\n+\n+    // `canGoBack()` is parent-aware. A single-entry Perps stack still reports\n+    // true when the main stack can pop `PERPS.ROOT` — that's correct for\n+    // Explore/homepage (return to that screen) and wrong after Lite -> Pro\n+    // dropped Perps Home (TAT-3786), which would dump the user on wallet.\n+    // `dropPerpsHomeFromStackHistory` stamps remaining routes so we can tell\n+    // those two single-entry stacks apart.\n+    if (\n+      canGoBack &&\n+      (hasPerpsStackHistory || !wasPerpsHomeDroppedFromHistory(perpsState))\n+    ) {","path":"app/components/UI/Perps/hooks/usePerpsMarketHeaderActions.ts","commit_id":"44514f37ccdbf4ce037a8f353aa4b36b6dd84fc8","original_commit_id":"44514f37ccdbf4ce037a8f353aa4b36b6dd84fc8","user":{"login":"michalconsensys","id":208771421,"node_id":"U_kgDODHGZXQ","avatar_url":"https://avatars.githubusercontent.com/u/208771421?v=4","gravatar_id":"","url":"https://api.github.com/users/michalconsensys","html_url":"https://github.com/michalconsensys","followers_url":"https://api.github.com/users/michalconsensys/followers","following_url":"https://api.github.com/users/michalconsensys/following{/other_user}","gists_url":"https://api.github.com/users/michalconsensys/gists{/gist_id}","starred_url":"https://api.github.com/users/michalconsensys/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/michalconsensys/subscriptions","organizations_url":"https://api.github.com/users/michalconsensys/orgs","repos_url":"https://api.github.com/users/michalconsensys/repos","events_url":"https://api.github.com/users/michalconsensys/events{/privacy}","received_events_url":"https://api.github.com/users/michalconsensys/received_events","type":"User","user_view_type":"public","site_admin":false},"body":"**Should-fix:** this stamp check only runs from the header `onBackPress` handler.\n\nNative-stack iOS edge-swipe and Android hardware back still go th